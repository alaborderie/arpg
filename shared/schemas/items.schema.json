{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpg.example/schemas/items.schema.json",
  "title": "Item bases and affix pool",
  "description": "Equippable item base types (with implicit stats) and the affix pool loot rolls draw from. Loaded identically by the Godot client and the Go server, so it is the single source of truth for these numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bases", "affixes"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on any breaking change to this file's shape."
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/base" }
    },
    "affixes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/affix" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable snake_case identifier; never reused or renamed."
    },
    "slot": {
      "enum": ["weapon", "armor"],
      "description": "The equipment slot an item occupies. M3 ships two slots."
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slot", "implicit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "slot": { "$ref": "#/$defs/slot" },
        "implicit": {
          "type": "object",
          "description": "Stats every item of this base carries before affixes.",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "damage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "base_min", "base_max"],
              "properties": {
                "type": { "enum": ["physical", "fire", "cold", "lightning"] },
                "base_min": { "type": "integer", "minimum": 0 },
                "base_max": { "type": "integer", "minimum": 0 }
              }
            },
            "armor": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "affix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "stat", "min", "max", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display fragment: prefixes prepend to the base name, suffixes append."
        },
        "kind": { "enum": ["prefix", "suffix"] },
        "stat": {
          "enum": [
            "added_damage",
            "increased_damage_pct",
            "added_armor",
            "attack_speed_pct",
            "crit_chance_pct",
            "fire_resistance",
            "cold_resistance",
            "lightning_resistance"
          ],
          "description": "Which stat the rolled value modifies; see game/domain/item_stats.gd for the exact math."
        },
        "min": { "type": "integer", "minimum": 0, "description": "Inclusive lower bound of the rolled value." },
        "max": { "type": "integer", "minimum": 0, "description": "Inclusive upper bound of the rolled value." },
        "slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slot" },
          "description": "Which base slots this affix can appear on."
        }
      }
    }
  }
}
