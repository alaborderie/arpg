{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpg.example/schemas/player.schema.json",
  "title": "Player base configuration",
  "description": "Baseline (unmodified by gear or passives) player parameters. Loaded identically by the Godot client and the Go server, so it is the single source of truth for these numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "player"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on any breaking change to this file's shape."
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_speed", "max_health", "armor", "damage",
        "crit_chance", "crit_multiplier", "attack_speed", "attack_range",
        "projectile_speed"
      ],
      "properties": {
        "move_speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Base movement speed in world units (metres) per second."
        },
        "max_health": { "type": "integer", "minimum": 1 },
        "armor": { "type": "integer", "minimum": 0 },
        "damage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "base_min", "base_max"],
          "properties": {
            "type": { "enum": ["physical", "fire", "cold", "lightning"] },
            "base_min": { "type": "integer", "minimum": 0 },
            "base_max": { "type": "integer", "minimum": 0 }
          }
        },
        "crit_chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "crit_multiplier": { "type": "number", "minimum": 1 },
        "attack_speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Attacks per second."
        },
        "attack_range": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum distance (metres, between body origins) at which an attack connects."
        },
        "projectile_speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Metres per second a ranged skill's Projectile travels (G8, docs/0021's faster_projectiles support scales this via PlayerStats.compose's projectile_speed_pct); matches Projectile.SPEED's pre-G8 hard-coded value."
        }
      }
    }
  }
}
