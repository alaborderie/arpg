; Godot project configuration.
;
; Renderer: Forward Mobile (see docs/0002-godot-renderer-forward-mobile.md).
; The `mobile` rendering method is Godot's Vulkan/Metal pipeline tuned for phones;
; it gives us decent dynamic lighting/shadows for the flat-shaded low-poly look
; while staying lighter than the desktop-oriented Forward+ path.
;
; Engine-managed file. Most values are edited through the Godot editor UI, but the
; project boots headlessly from this file too (that is how CI runs the tests).

config_version=5

[application]

config/name="ARPG (working title)"
config/description="Top-down action RPG. Offline-first, low-poly flat-shaded."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "Forward Mobile")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[input]

move_to={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[input_devices]

; Default is already true; pinned here because M1's tap-to-move depends on it:
; touches arrive as left-mouse events, so one input path serves desktop and mobile.
pointing/emulate_mouse_from_touch=true

[navigation]

; Build navigation maps synchronously. The async default trades determinism for
; not stalling huge open-world bakes; our maps are small, and both headless tests
; and future server-side simulation want "bake done => paths queryable next frame".
world/map_use_async_iterations=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
